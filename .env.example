# In production: postgresql+asyncpg://user:password@host:5432/dbname

REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:3000

NEWS_API_KEY=
GEMINI_API_KEY=
SIMULATOR_API_KEY=
